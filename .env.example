APP_ENV=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3001
SECRET_KEY=change-me-in-development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# PostgreSQL
POSTGRES_DB=fasrord
POSTGRES_USER=fasrord
POSTGRES_PASSWORD=fasrord_dev_password
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Cloudinary (backend only; never expose the API secret to the frontend)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_MAX_UPLOAD_BYTES=5242880

# Redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
